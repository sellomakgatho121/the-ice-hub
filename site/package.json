    "verify": "npm run verify:host && npm run verify:browser",
    "verify:browser": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "jsdom": "^30.1.2",
    "playwright": "^1.55.0"
  }
}
