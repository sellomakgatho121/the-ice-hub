{
  "name": "the-ice-hub-site",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "python -m http.server 8000",
    "test": "node --test scripts/*.test.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
