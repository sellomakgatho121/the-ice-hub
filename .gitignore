.DS_Store

# Vercel: links this directory to a project ID and writes local build state.
# Committing it leaks the project reference and breaks other clones' deploys.
.vercel/

# Credentials must never reach the repo. config.js ships to the browser, so a
# live key pasted there is public the moment it deploys.
.env
.env.*
!.env.example
